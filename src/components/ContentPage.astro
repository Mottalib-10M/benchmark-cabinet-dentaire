---
/**
 * Rendu d'un guide ou d'une page outil défini dans `src/content/`. Ordre (RECETTE §9.3, §21) :
 * H1 et chapeau ; page outil : l'outil, puis le bloc citable replié ; guide : le bloc citable, puis
 * le mini-simulateur, puis le corps. FAQ, pages associées, sources et encart auteur viennent du
 * PageLayout, avec la FAQ affichée et balisée depuis la même liste (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Benchmark from './calc/Benchmark';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import { fixOrdinals } from '../lib/format';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const parts = fixOrdinals(x.body(helpers(lang)), lang).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (x.faqs.length) jsonLd.push(faqSchema(x.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
const cible = page.miniHref ?? 'home';
const miniHref = ROUTES.some((r) => r.id === cible) ? route(cible, lang) : undefined;
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-3 sm:mb-4">
      <h1 class="text-[1.75rem] font-bold leading-tight text-navy-900 sm:text-3xl md:text-4xl">{x.h1}</h1>
      <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        <div data-outil class="mb-4">
          {page.tool === 'benchmark' && <Benchmark client:load lang={lang} methodHref={methodHref} spec={page.spec ?? 'omni'} />}
        </div>
        <p class="mb-8 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
      </>
    ) : (
      <>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        {page.mini && <MiniSim client:load spacing="mb-4 mt-3" kind={page.mini} lang={lang} href={miniHref} />}
        <p class="mb-8 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
      </>
    )}
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div data-chrome><MiniSim client:load kind={p} lang={lang} href={miniHref} secondaire /></div>)}
    </div>
  </article>
</PageLayout>
