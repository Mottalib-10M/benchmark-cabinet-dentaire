---
/** Page embarquable (iframe) : simulateur sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import Benchmark from '../../components/calc/Benchmark';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dental practice benchmark – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Benchmark client:load lang="en" />
    <div class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">dentimetre.fr</a> · Assurance Maladie data, computed in your browser</div>
  </body>
</html>
