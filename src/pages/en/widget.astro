---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/practice-benchmark/" title="French dental practice benchmark: fees against the département average" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French dental practice benchmark on your website" description="Embed the French dental practice benchmark for free in an iframe: fees against Assurance Maladie averages, no sign-up, no cookies, everything computed in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the practice benchmark</h1>
    <p class="mt-3 text-lg text-navy-700">One snippet to paste, free and with no account. The full calculator loads from this site and follows every Assurance Maladie data update.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the credit link under the calculator visible, do not alter the content; the tool comes without warranty. For the French version, use <code>{`${SITE_URL}/embed/comparateur-cabinet/`}</code>.</p>
    <p>The fees and costs a practitioner types into the embedded frame stay on their own computer: no server receives them and no cookie is set. A journal or management association wanting an adapted version can write to us via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/practice-benchmark/" title="French dental practice benchmark" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
